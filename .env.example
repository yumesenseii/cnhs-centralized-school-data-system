# --- Local Next.js + Supabase (add your existing keys below as needed) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Random Forest Academic Risk ML service (FastAPI)
# Local: start with `npm run ml:serve` or both with `npm run dev:all`
RF_INFERENCE_URL=http://127.0.0.1:8000
# Production (Vercel): set to your hosted ml-service base URL — no /predict suffix
# RF_INFERENCE_URL=https://your-ml-service.example.com
# RF_INFERENCE_TIMEOUT_MS=8000
# RF_INFERENCE_BATCH_TIMEOUT_MS=90000
# RF_INFERENCE_BATCH_CHUNK=80
# Optional: same secret on Vercel and ml-service
# RF_INFERENCE_API_KEY=

# Brevo transactional email (Edge Function secrets — welcome + forgot password)
# Set via: supabase secrets set BREVO_API_KEY=... BREVO_SENDER_EMAIL=... APP_ORIGIN=...
# Do not put a real API key in this file.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=CNHS Learn
# Public site origin used in welcome + reset email links
# APP_ORIGIN=https://your-cnhs-learn-host
#
# Forgot password uses Edge Function `request-password-reset` → Brevo API
# (same BREVO_* as admin-create-user). Deploy:
#   supabase functions deploy request-password-reset
# Fallback: HT User Management → Reset Password.
